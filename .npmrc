# Do not let pnpm download/switch itself to the `packageManager` version.
# With a pnpm from mise and a packageManager pin in an ancestor package.json,
# self-management recursed into a fork bomb on the dev machine.
manage-package-manager-versions=false
# Fail install under a Node outside `engines` (.nvmrc = 22): native modules
# such as better-sqlite3 are built for the Node that runs the install.
engine-strict=true
