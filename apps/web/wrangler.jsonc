{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "azway-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    // Self-reference used by OpenNext for cache revalidation; must match "name".
    { "binding": "WORKER_SELF_REFERENCE", "service": "azway-web" }
  ],
  // Production resources are created in the AZway account in M8; locally
  // wrangler simulates them, so the names/ids below only matter on deploy.
  "r2_buckets": [{ "binding": "NEXT_INC_CACHE_R2_BUCKET", "bucket_name": "azway-web-opennext-cache" }],
  "d1_databases": [
    {
      "binding": "NEXT_TAG_CACHE_D1",
      "database_name": "azway-web-tag-cache",
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ],
  // Non-secret runtime config; declared here so `wrangler deploy` does not
  // wipe values set elsewhere. Real values are filled in M8; locally
  // .dev.vars overrides them. Secrets: `wrangler secret put`.
  "vars": { "CMS_URL": "", "CMS_MEDIA_URL": "" },
  // Next.js image optimization (/_next/image) through Cloudflare Images.
  "images": { "binding": "IMAGES" },
  "observability": { "enabled": true }
}
