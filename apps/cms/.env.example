# Copy to .env and fill every secret below; Strapi refuses to start without them.
# Generate each value with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# APP_KEYS takes two or more such values, comma-separated.

# Server
HOST=0.0.0.0
PORT=1337
# Public base URL of the CMS. Required in production, e.g. https://cms.<domain>
PUBLIC_URL=
# Admin panel path (NFR-07). Read at `strapi build`; rebuild after changing.
ADMIN_PATH=/admin
# true behind a TLS-terminating proxy (PaaS, Caddy): Secure admin cookie, client IP
SERVER_PROXY=false
# Header with the client IP (last entry is used). Render: True-Client-IP
SERVER_PROXY_IP_HEADER=X-Forwarded-For

# Strapi secrets (required)
APP_KEYS=
API_TOKEN_SALT=
ADMIN_JWT_SECRET=
TRANSFER_TOKEN_SALT=
JWT_SECRET=
ENCRYPTION_KEY=

# Database: sqlite (dev, file .tmp/data.db) or postgres (prod)
DATABASE_CLIENT=sqlite
# Postgres: DATABASE_URL, or the discrete fields below (leave unset, not empty)
# DATABASE_URL=postgres://strapi:strapi@localhost:5432/strapi
# DATABASE_HOST=localhost
# DATABASE_PORT=5432
# DATABASE_NAME=strapi
# DATABASE_USERNAME=strapi
# DATABASE_PASSWORD=strapi
# DATABASE_SSL=false

# Cloudflare R2 media storage. Leave any empty -> local uploads in public/uploads
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public URL of the bucket, e.g. https://media.<domain> (also allowed in CSP)
R2_PUBLIC_URL=

# Comma-separated origins allowed by CORS. Empty -> http://localhost:3000
CORS_ORIGINS=

# Lead ingest: shared secret with apps/web (required)
LEAD_INGEST_TOKEN=

# Google Sheets sync. Missing -> leads saved with sheetsStatus=skipped
GOOGLE_SA_EMAIL=
GOOGLE_SA_PRIVATE_KEY=
GOOGLE_SHEET_ID=
# Default A:S. GOOGLE_SA_PRIVATE_KEY: the PEM on one line, newlines written as \n
GOOGLE_SHEET_RANGE=
# Tests only: point Google at a local mock server
# GOOGLE_TOKEN_URL=
# GOOGLE_SHEETS_API_URL=

# Email via Resend. Missing RESEND_API_KEY -> emails are only logged
RESEND_API_KEY=
MAIL_FROM=
# Tests only: point Resend at a local mock server
# RESEND_API_URL=
# Comma-separated recipients of Sheets failure alerts
ALERT_EMAILS=
# New-lead recipients when site-setting.leadNotifyEmails is empty
LEAD_NOTIFY_EMAILS=

# Cron: Sheets re-sync of failed/stuck leads
CRON_ENABLED=true
LEAD_RETRY_CRON=*/10 * * * *

# On-demand revalidation of the web app, e.g. https://<domain>/api/revalidate
WEB_REVALIDATE_URL=
REVALIDATE_SECRET=
