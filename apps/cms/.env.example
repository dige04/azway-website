# Copy to .env. Generate each secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"

# Server
HOST=0.0.0.0
PORT=1337
# Public base URL of the CMS. Required in production, e.g. https://cms.<domain>
PUBLIC_URL=
# Admin panel path (NFR-07). Read at `strapi build`; rebuild after changing.
ADMIN_PATH=/admin

# Strapi secrets (required)
APP_KEYS=toBeModified1,toBeModified2
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# Database: sqlite (dev, file .tmp/data.db) or postgres (prod)
DATABASE_CLIENT=sqlite
# Postgres: DATABASE_URL, or the discrete fields below (leave unset, not empty)
# DATABASE_URL=postgres://strapi:strapi@localhost:5432/strapi
# DATABASE_HOST=localhost
# DATABASE_PORT=5432
# DATABASE_NAME=strapi
# DATABASE_USERNAME=strapi
# DATABASE_PASSWORD=strapi
# DATABASE_SSL=false

# Cloudflare R2 media storage. Leave any empty -> local uploads in public/uploads
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public URL of the bucket, e.g. https://media.<domain> (also allowed in CSP)
R2_PUBLIC_URL=

# Comma-separated origins allowed by CORS. Empty -> http://localhost:3000
CORS_ORIGINS=

# Lead ingest: shared secret with apps/web (required)
LEAD_INGEST_TOKEN=tobemodified

# Google Sheets sync. Missing -> leads saved with sheetsStatus=skipped
GOOGLE_SA_EMAIL=
GOOGLE_SA_PRIVATE_KEY=
GOOGLE_SHEET_ID=
GOOGLE_SHEET_RANGE=

# Email via Resend. Missing RESEND_API_KEY -> emails are only logged
RESEND_API_KEY=
MAIL_FROM=
# Comma-separated recipients of Sheets failure alerts
ALERT_EMAILS=

# On-demand revalidation of the web app, e.g. https://<domain>/api/revalidate
WEB_REVALIDATE_URL=
REVALIDATE_SECRET=
