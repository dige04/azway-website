{
  "kind": "collectionType",
  "collectionName": "tours",
  "info": { "singularName": "tour", "pluralName": "tours", "displayName": "Tour", "description": "Tour trong nước, Trung Quốc, quốc tế, trải nghiệm học tập" },
  "options": { "draftAndPublish": true },
  "pluginOptions": { "i18n": { "localized": true } },
  "attributes": {
    "name": { "type": "string", "required": true, "pluginOptions": { "i18n": { "localized": true } } },
    "code": { "type": "string", "required": true, "unique": true, "pluginOptions": { "i18n": { "localized": false } } },
    "slug": { "type": "uid", "targetField": "name", "required": true, "pluginOptions": { "i18n": { "localized": true } } },
    "category": { "type": "enumeration", "enum": ["noi_dia", "trung_quoc", "quoc_te", "trai_nghiem_hoc_tap"], "required": true, "pluginOptions": { "i18n": { "localized": false } } },
    "departure": { "type": "string", "pluginOptions": { "i18n": { "localized": true } } },
    "borderGate": { "type": "string", "pluginOptions": { "i18n": { "localized": false } } },
    "durationDays": { "type": "integer", "required": true, "min": 1, "pluginOptions": { "i18n": { "localized": false } } },
    "durationNights": { "type": "integer", "required": true, "min": 0, "default": 0, "pluginOptions": { "i18n": { "localized": false } } },
    "transport": { "type": "string", "pluginOptions": { "i18n": { "localized": true } } },
    "priceFrom": { "type": "integer", "min": 0, "pluginOptions": { "i18n": { "localized": false } } },
    "focNote": { "type": "text", "pluginOptions": { "i18n": { "localized": true } } },
    "groupSizeMin": { "type": "integer", "min": 1, "pluginOptions": { "i18n": { "localized": false } } },
    "groupSizeMax": { "type": "integer", "min": 1, "pluginOptions": { "i18n": { "localized": false } } },
    "thumbnail": { "type": "media", "multiple": false, "allowedTypes": ["images"], "pluginOptions": { "i18n": { "localized": false } } },
    "gallery": { "type": "media", "multiple": true, "allowedTypes": ["images"], "pluginOptions": { "i18n": { "localized": false } } },
    "highlights": { "type": "component", "repeatable": true, "component": "shared.text-item", "pluginOptions": { "i18n": { "localized": true } } },
    "itinerary": { "type": "component", "repeatable": true, "component": "tour.itinerary-day", "pluginOptions": { "i18n": { "localized": true } } },
    "inclusions": { "type": "component", "repeatable": true, "component": "shared.text-item", "pluginOptions": { "i18n": { "localized": true } } },
    "exclusions": { "type": "component", "repeatable": true, "component": "shared.text-item", "pluginOptions": { "i18n": { "localized": true } } },
    "cancellationRules": { "type": "component", "repeatable": true, "component": "tour.cancellation-rule", "pluginOptions": { "i18n": { "localized": true } } },
    "destinations": { "type": "relation", "relation": "manyToMany", "target": "api::destination.destination", "inversedBy": "tours" },
    "articles": { "type": "relation", "relation": "manyToMany", "target": "api::article.article", "mappedBy": "tours" },
    "teambuildings": { "type": "relation", "relation": "manyToMany", "target": "api::teambuilding.teambuilding", "mappedBy": "tours" },
    "feedbacks": { "type": "relation", "relation": "oneToMany", "target": "api::feedback.feedback", "mappedBy": "tour" },
    "seo": { "type": "component", "repeatable": false, "component": "shared.seo", "pluginOptions": { "i18n": { "localized": true } } }
  },
  "config": {
    "metadatas": {
      "name": { "edit": { "label": "Tên tour" } },
      "code": { "edit": { "label": "Mã tour", "description": "Duy nhất, dùng để tìm kiếm và gắn vào yêu cầu khách, ví dụ AZ-HL-2N1D" } },
      "slug": { "edit": { "label": "Đường dẫn (slug)", "description": "Tự sinh từ tên; chữ không dấu, nối bằng gạch ngang" } },
      "category": { "edit": { "label": "Loại tour", "description": "noi_dia = trong nước, trung_quoc = Trung Quốc, quoc_te = quốc tế, trai_nghiem_hoc_tap = trải nghiệm học tập" } },
      "departure": { "edit": { "label": "Điểm khởi hành" } },
      "borderGate": { "edit": { "label": "Cửa khẩu", "description": "Chỉ với tour qua biên giới. Ghi thống nhất một cách viết (ví dụ Hữu Nghị, Móng Cái) để bộ lọc gộp đúng" } },
      "durationDays": { "edit": { "label": "Số ngày" } },
      "durationNights": { "edit": { "label": "Số đêm" } },
      "transport": { "edit": { "label": "Phương tiện", "description": "Ví dụ: Ô tô, máy bay" } },
      "priceFrom": { "edit": { "label": "Giá từ (đ/khách)", "description": "Số nguyên VND, không dấu chấm. Để trống hoặc 0 thì hiện \"Liên hệ báo giá\"" } },
      "focNote": { "edit": { "label": "Ghi chú FOC", "description": "Ví dụ: Đoàn 20 khách tặng 1 suất miễn phí" } },
      "groupSizeMin": { "edit": { "label": "Quy mô đoàn tối thiểu (khách)" } },
      "groupSizeMax": { "edit": { "label": "Quy mô đoàn tối đa (khách)" } },
      "thumbnail": { "edit": { "label": "Ảnh đại diện", "description": "Ảnh trên thẻ tour. Nhớ điền mô tả ảnh (alt) trong Thư viện media" } },
      "gallery": { "edit": { "label": "Bộ ảnh" } },
      "highlights": { "edit": { "label": "Điểm nổi bật" } },
      "itinerary": { "edit": { "label": "Lịch trình", "description": "Mỗi ngày một mục; trong ngày thêm các mốc giờ, kéo thả để sắp xếp" } },
      "inclusions": { "edit": { "label": "Bao gồm" } },
      "exclusions": { "edit": { "label": "Không bao gồm" } },
      "cancellationRules": { "edit": { "label": "Điều kiện hoàn huỷ" } },
      "destinations": { "edit": { "label": "Điểm đến" } },
      "articles": { "edit": { "label": "Bài cẩm nang liên quan" } },
      "teambuildings": { "edit": { "label": "Chương trình teambuilding" } },
      "feedbacks": { "edit": { "label": "Feedback của đoàn" } },
      "seo": { "edit": { "label": "SEO" } }
    }
  }
}
